# =============================================================================
# Philomena production environment
# Copy this file to .env and fill in the values before running:
#   docker compose -f docker-compose.prod.yml up -d
# =============================================================================

# =============================================================================
# Database
# POSTGRES_PASSWORD is used by the postgres container and by the setup init
# container. Make sure the password embedded in DATABASE_URL matches exactly.
# =============================================================================
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=ecto://postgres:change_me_strong_password@postgres/philomena_prod

# =============================================================================
# Security secrets — generate each with: openssl rand -base64 48
# =============================================================================
SECRET_KEY_BASE=
ANONYMOUS_NAME_SALT=
PASSWORD_PEPPER=
OTP_SECRET_KEY=

# =============================================================================
# Domain / URL configuration
#
# APP_HOSTNAME  — bare hostname used by Phoenix to build internal URLs
# CDN_HOST      — bare hostname used by the app to build image/media URLs
# SITE_DOMAINS  — comma-separated list of accepted request hostnames
# APP_URL       — full URL for the Caddy app site block  (http://)
# CDN_URL       — full URL for the Caddy CDN site block  (http://)
# SITE_DOMAIN   — single hostname for Caddy rate-limiting (no scheme)
#
# Both APP_URL and CDN_URL must be different addresses so Caddy can route by
# Host header. The simplest approach: two subdomains pointing at the same IP.
# Your external Caddy should reverse-proxy both to philomena-web:80.
# =============================================================================
APP_HOSTNAME=example.com
CDN_HOST=cdn.example.com
SITE_DOMAINS=example.com
APP_URL=http://example.com
CDN_URL=http://cdn.example.com
SITE_DOMAIN=example.com

# Alternatively, use different ports on the same hostname (image URLs will
# include the port number):
# CDN_HOST=example.com:8081
# CDN_URL=http://example.com:8081

# =============================================================================
# App server
# APP_IP should be 0.0.0.0 so the app binds to all interfaces inside Docker.
# =============================================================================
APP_IP=0.0.0.0
PORT=4000
MAILER_ADDRESS=noreply@example.com

# =============================================================================
# SMTP
# =============================================================================
SMTP_RELAY=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# hCaptcha
# Test keys below work for local/staging. Replace with real keys for production:
#   https://dashboard.hcaptcha.com/
# =============================================================================
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# =============================================================================
# S3-compatible file storage
#
# S3_HOST / S3_PORT / S3_SCHEME — used by the Elixir app (ExAws)
# S3_ENDPOINT                   — used by Caddy's S3 filesystem plugin
#
# The defaults below point at the local s3proxy container (files service).
# To use an external service (Backblaze B2, Cloudflare R2, MinIO, etc.),
# update all five values accordingly.
# =============================================================================
S3_SCHEME=http
S3_HOST=files
S3_PORT=80
S3_BUCKET=philomena
S3_ENDPOINT=http://files:80
AWS_ACCESS_KEY_ID=local-identity
AWS_SECRET_ACCESS_KEY=local-credential

# =============================================================================
# File path roots (S3 key prefixes — no leading slash)
# =============================================================================
ADVERT_FILE_ROOT=adverts
AVATAR_FILE_ROOT=avatars
BADGE_FILE_ROOT=badges
IMAGE_FILE_ROOT=images
TAG_FILE_ROOT=tags

# =============================================================================
# URL path roots (HTTP paths served by Caddy from S3)
# =============================================================================
AVATAR_URL_ROOT=/avatars
ADVERT_URL_ROOT=/spns
IMAGE_URL_ROOT=/img
BADGE_URL_ROOT=/badge-img
TAG_URL_ROOT=/tag-img

# =============================================================================
# OpenSearch
# =============================================================================
OPENSEARCH_URL=http://opensearch:9200

# =============================================================================
# Redis / Valkey
# =============================================================================
REDIS_HOST=valkey

# =============================================================================
# Tumblr API key (only needed if using Tumblr source import)
# =============================================================================
TUMBLR_API_KEY=not_used

# =============================================================================
# Optional: image proxy (camo) — proxy external images through your server
# Uncomment and fill in to enable.
# =============================================================================
# CAMO_HOST=https://camo.example.com
# CAMO_KEY=

# =============================================================================
# Optional: personal/private instance toggles
# Set any of these to "false" to disable the feature. All default to "true".
# =============================================================================
# REGISTRATION_ENABLED=false
# ANONYMOUS_UPLOADS_ENABLED=false
# COMMENTS_ENABLED=false

# =============================================================================
# Optional: secondary S3 bucket (for multi-region replication)
# =============================================================================
# ALT_S3_SCHEME=https
# ALT_S3_HOST=
# ALT_S3_PORT=443
# ALT_S3_BUCKET=
# ALT_AWS_ACCESS_KEY_ID=
# ALT_AWS_SECRET_ACCESS_KEY=
